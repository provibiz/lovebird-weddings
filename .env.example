# ── Cosmic CMS ────────────────────────────────────────────────
# Read key is used at build time / on the public site (safe-ish, read-only).
# Write key is ONLY ever used server-side in /api routes. Never expose it.
COSMIC_BUCKET_SLUG=
COSMIC_READ_KEY=
COSMIC_WRITE_KEY=

# ── Cloudflare deploy hook ────────────────────────────────────
# Optional: a Deploy Hook URL from Cloudflare Pages. The dashboard can POST
# to it after a content save to trigger a fresh static rebuild.
CLOUDFLARE_DEPLOY_HOOK_URL=

# ── Dashboard auth (prototype) ────────────────────────────────
# Simple env-based credentials for the client dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret used to sign the dashboard session cookie. Use a long random string.
SESSION_SECRET=
