---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { isCosmicConfigured } from '@/lib/cosmic';
export const prerender = false;

const cosmicConfigured = isCosmicConfigured();
const tiles = [
  { href: '/dashboard/startseite', title: 'Startseite', desc: 'Hero, Über mich, Teaser, Bilder' },
  { href: '/dashboard/leistungen', title: 'Leistungen', desc: 'Titel & Beschreibungen eurer Angebote' },
  { href: '/dashboard/portfolio', title: 'Portfolio', desc: 'Projekte & Bilder verwalten' },
  { href: '/dashboard/faq', title: 'FAQ', desc: 'Häufige Fragen & Antworten' },
  { href: '/dashboard/medien', title: 'Medien', desc: 'Bilder hochladen & verwalten' },
  { href: '/dashboard/kontakt', title: 'Kontaktdaten', desc: 'Telefon, E-Mail, Standort, Instagram' },
  { href: '/dashboard/seo', title: 'SEO', desc: 'Seitentitel & Meta-Beschreibungen' },
];
---
<DashboardLayout title="Dashboard" active="home" cosmicConfigured={cosmicConfigured}>
  <h1>Willkommen 👋</h1>
  <p class="lead">Hier pflegst du die Inhalte deiner Website. Wähle einen Bereich.</p>
  <div class="tiles">
    {tiles.map((t) => (
      <a class="tile" href={t.href}>
        <h3>{t.title}</h3>
        <p>{t.desc}</p>
      </a>
    ))}
  </div>

  {cosmicConfigured && (
    <div class="card" style="margin-top:32px">
      <h2>Ersteinrichtung</h2>
      <p class="desc">
        Einmalig ausführen: legt im Cosmic-Bucket die Inhaltstypen an und befüllt sie mit den
        aktuellen Inhalten. Bereits vorhandene Inhalte werden dabei <strong>nicht</strong>
        überschrieben.
      </p>
      <div class="save-bar">
        <button type="button" class="btn-save" data-seed>Cosmic einrichten &amp; befüllen</button>
        <span class="status" data-seed-status></span>
      </div>
    </div>
  )}
</DashboardLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-seed]');
  const status = document.querySelector<HTMLElement>('[data-seed-status]');
  btn?.addEventListener('click', async () => {
    if (!confirm('Cosmic jetzt einrichten und mit den aktuellen Inhalten befüllen?')) return;
    btn.setAttribute('disabled', 'true');
    if (status) { status.textContent = 'Richte ein…'; status.className = 'status'; }
    try {
      const res = await fetch('/api/seed', { method: 'POST' });
      const j = await res.json();
      if (status) {
        status.textContent = j.ok ? j.message : (j.error ?? 'Fehler.');
        status.className = 'status ' + (j.ok ? 'ok' : 'error');
      }
    } catch {
      if (status) { status.textContent = 'Netzwerkfehler.'; status.className = 'status error'; }
    } finally {
      btn.removeAttribute('disabled');
    }
  });
</script>
