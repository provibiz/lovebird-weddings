---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { isCosmicConfigured } from '@/lib/cosmic';
export const prerender = false;

const cosmicConfigured = isCosmicConfigured();
const tiles = [
  { href: '/dashboard/startseite', title: 'Startseite', desc: 'Hero-Überschrift, Text und Button' },
  { href: '/dashboard/leistungen', title: 'Leistungen', desc: 'Titel & Beschreibungen eurer Angebote' },
  { href: '/dashboard/faq', title: 'FAQ', desc: 'Häufige Fragen & Antworten' },
  { href: '/dashboard/kontakt', title: 'Kontaktdaten', desc: 'Telefon, E-Mail, Standort, Instagram' },
  { href: '/dashboard/seo', title: 'SEO', desc: 'Seitentitel & Meta-Beschreibungen' },
];
---
<DashboardLayout title="Dashboard" active="home" cosmicConfigured={cosmicConfigured}>
  <h1>Willkommen 👋</h1>
  <p class="lead">Hier pflegst du die Inhalte deiner Website. Wähle einen Bereich.</p>
  <div class="tiles">
    {tiles.map((t) => (
      <a class="tile" href={t.href}>
        <h3>{t.title}</h3>
        <p>{t.desc}</p>
      </a>
    ))}
  </div>
</DashboardLayout>
