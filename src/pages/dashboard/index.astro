---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { isCosmicConfigured } from '@/lib/cosmic';
export const prerender = false;

const cosmicConfigured = isCosmicConfigured();
const tiles = [
  { href: '/dashboard/startseite', title: 'Startseite', desc: 'Hero, Über mich, Teaser, Bilder' },
  { href: '/dashboard/leistungen', title: 'Leistungen', desc: 'Titel & Beschreibungen eurer Angebote' },
  { href: '/dashboard/portfolio', title: 'Portfolio', desc: 'Projekte & Bilder verwalten' },
  { href: '/dashboard/faq', title: 'FAQ', desc: 'Häufige Fragen & Antworten' },
  { href: '/dashboard/medien', title: 'Medien', desc: 'Bilder hochladen & verwalten' },
  { href: '/dashboard/kontakt', title: 'Kontaktdaten', desc: 'Telefon, E-Mail, Standort, Instagram' },
  { href: '/dashboard/seo', title: 'SEO', desc: 'Seitentitel & Meta-Beschreibungen' },
];
---
<DashboardLayout title="Dashboard" active="home" cosmicConfigured={cosmicConfigured}>
  <h1>Willkommen 👋</h1>
  <p class="lead">Hier pflegst du die Inhalte deiner Website. Wähle einen Bereich.</p>
  <div class="tiles">
    {tiles.map((t) => (
      <a class="tile" href={t.href}>
        <h3>{t.title}</h3>
        <p>{t.desc}</p>
      </a>
    ))}
  </div>

  {cosmicConfigured && (
    <div class="card" style="margin-top:32px">
      <h2>Inhalte einrichten / zurücksetzen</h2>
      <p class="desc">
        Legt die Inhaltstypen an und befüllt sie mit den aktuellen Website-Inhalten.
        <strong>Achtung:</strong> Bereits in Cosmic gespeicherte Inhalte werden dabei mit
        dem Standardstand <strong>überschrieben</strong>. Ideal für die Ersteinrichtung
        oder um einen sauberen Ausgangszustand wiederherzustellen.
      </p>
      <div class="save-bar">
        <button type="button" class="btn-save" data-seed>Inhalte einrichten / zurücksetzen</button>
        <span class="status" data-seed-status></span>
      </div>
    </div>
  )}
</DashboardLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-seed]');
  const status = document.querySelector<HTMLElement>('[data-seed-status]');
  const set = (msg: string, kind = '') => {
    if (status) { status.textContent = msg; status.className = 'status ' + kind; }
  };
  async function seedStep(step: 'schema' | 'content', offset = 0) {
    const res = await fetch('/api/seed', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ step, offset }),
    });
    return res.json();
  }
  btn?.addEventListener('click', async () => {
    if (!confirm('Inhalte in Cosmic anlegen bzw. auf den aktuellen Stand der Website setzen? Bestehende Cosmic-Inhalte werden dabei überschrieben.')) return;
    btn.setAttribute('disabled', 'true');
    try {
      set('1/2 · Inhaltstypen vorbereiten…');
      const schema = await seedStep('schema');
      if (!schema.ok) { set(schema.error ?? 'Fehler.', 'error'); return; }

      let total = 0;
      let offset = 0;
      // content runs in bounded offset batches until done (subrequest-limit safe)
      for (let pass = 0; pass < 20; pass++) {
        set(`2/2 · Inhalte schreiben… (${total})`);
        const content = await seedStep('content', offset);
        if (!content.ok) { set(content.error ?? 'Fehler.', 'error'); return; }
        total += content.written ?? 0;
        offset = content.nextOffset ?? offset;
        if (content.done) break;
      }
      set(`Fertig ✓ ${total} Inhalte gesetzt. Bitte Website neu veröffentlichen (Speichern löst das aus).`, 'ok');
    } catch {
      set('Netzwerkfehler.', 'error');
    } finally {
      btn.removeAttribute('disabled');
    }
  });
</script>
