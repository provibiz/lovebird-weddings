---
// Hidden developer-only page (not linked in the dashboard navigation).
// Reachable directly at /dashboard/setup. Auth-protected by middleware.
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { isCosmicConfigured } from '@/lib/cosmic';
export const prerender = false;

const cosmicConfigured = isCosmicConfigured();
---
<DashboardLayout title="Setup" cosmicConfigured={cosmicConfigured}>
  <h1>Setup (intern)</h1>
  <p class="lead">Entwickler-Werkzeug – nicht für die Kundin gedacht.</p>

  {cosmicConfigured ? (
    <div class="card">
      <h2>Inhalte einrichten / zurücksetzen</h2>
      <p class="desc">
        Legt die Inhaltstypen an und befüllt sie mit den aktuellen Website-Inhalten.
        <strong>Achtung:</strong> Bereits in Cosmic gespeicherte Inhalte werden dabei mit
        dem Standardstand <strong>überschrieben</strong>.
      </p>
      <div class="save-bar">
        <button type="button" class="btn-save" data-seed>Inhalte einrichten / zurücksetzen</button>
        <span class="status" data-seed-status></span>
      </div>
    </div>
  ) : (
    <div class="banner">Cosmic ist nicht konfiguriert.</div>
  )}
</DashboardLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-seed]');
  const status = document.querySelector<HTMLElement>('[data-seed-status]');
  const set = (msg: string, kind = '') => {
    if (status) { status.textContent = msg; status.className = 'status ' + kind; }
  };
  async function seedStep(step: 'schema' | 'content', offset = 0) {
    const res = await fetch('/api/seed', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ step, offset }),
    });
    return res.json();
  }
  btn?.addEventListener('click', async () => {
    if (!confirm('Inhalte in Cosmic anlegen bzw. auf den aktuellen Stand der Website setzen? Bestehende Cosmic-Inhalte werden dabei überschrieben.')) return;
    btn.setAttribute('disabled', 'true');
    try {
      set('1/2 · Inhaltstypen vorbereiten…');
      const schema = await seedStep('schema');
      if (!schema.ok) { set(schema.error ?? 'Fehler.', 'error'); return; }

      let total = 0;
      let offset = 0;
      for (let pass = 0; pass < 20; pass++) {
        set(`2/2 · Inhalte schreiben… (${total})`);
        const content = await seedStep('content', offset);
        if (!content.ok) { set(content.error ?? 'Fehler.', 'error'); return; }
        total += content.written ?? 0;
        offset = content.nextOffset ?? offset;
        if (content.done) break;
      }
      set(`Fertig ✓ ${total} Inhalte gesetzt. Bitte Website neu veröffentlichen.`, 'ok');
    } catch {
      set('Netzwerkfehler.', 'error');
    } finally {
      btn.removeAttribute('disabled');
    }
  });
</script>
