---
import type { HomeTeaser } from '@/lib/types';
import { sanitizeHtml } from '@/lib/sanitize';
interface Props { teasers: HomeTeaser[] }
const { teasers } = Astro.props;
---
<section>
  <div class="section-head reveal">
    <span class="eyebrow">Unsere Leistungen</span>
    <h2>Mit Hingabe für euren <em style="font-style:italic;color:var(--gold)">schönsten Tag</em></h2>
    <div class="divider"></div>
    <p>Von der ersten Idee bis zum letzten Walzer – drei Wege, wie wir eure Hochzeit zu einem unvergesslichen Erlebnis machen.</p>
  </div>
  <div class="services">
    {teasers.map((s) => (
      <article class="service reveal">
        <div class="img"><img src={s.image} loading="lazy" alt={s.title} /></div>
        <div class="body">
          <div class="num">{s.num}</div>
          <h3>{s.title}</h3>
          <div class="rt" set:html={sanitizeHtml(s.text)}></div>
          <a href="/leistungen" class="more">Mehr erfahren</a>
        </div>
      </article>
    ))}
  </div>
</section>
