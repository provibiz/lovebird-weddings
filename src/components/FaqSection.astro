---
import type { Faq } from '@/lib/types';
import { sanitizeHtml } from '@/lib/sanitize';
interface Props { faqs: Faq[] }
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq">
    <div class="section-head reveal">
      <span class="eyebrow">Gut zu wissen</span>
      <h2>Häufige <em style="font-style:italic;color:var(--gold)">Fragen</em></h2>
      <div class="divider"></div>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item reveal">
          <summary>{f.question}<span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-answer rt" set:html={sanitizeHtml(f.answer)}></div>
        </details>
      ))}
    </div>
  </section>
)}
