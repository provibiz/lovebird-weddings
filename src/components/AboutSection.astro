---
import type { PageContent } from '@/lib/types';
import { sanitizeHtml } from '@/lib/sanitize';
interface Props { page: PageContent }
const { page } = Astro.props;

function renderTitle(raw: string): string {
  const escape = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escape(raw).replace(/\*([^*]+)\*/g, '<em style="font-style:italic;color:var(--gold)">$1</em>');
}

const title = renderTitle(page.about_title ?? 'Gemeinsam schaffen wir *Erinnerungen*.');
const textHtml = sanitizeHtml(page.about_text ?? '');
const img1 = page.about_image_1 ?? '/assets/images/img_028_5a661839.jpg';
const img2 = page.about_image_2 ?? '/assets/images/img_026_55fad26d.jpg';
---
<section>
  <div class="about-grid">
    <div class="about-imgs reveal">
      <img class="a" src={img1} loading="lazy" alt="Sarah – Lovebird Weddings" />
      <img class="b" src={img2} loading="lazy" alt="Sarah – Detailaufnahme" />
    </div>
    <div class="about-text reveal">
      <span class="eyebrow">Über mich</span>
      <h2 style="margin:18px 0 24px" set:html={title}></h2>
      <div class="rt" set:html={textHtml}></div>
      <div class="signature">— Sarah</div>
    </div>
  </div>
</section>
