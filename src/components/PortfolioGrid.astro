---
import type { PortfolioItem } from '@/lib/types';
interface Props { items: PortfolioItem[] }
const { items } = Astro.props;
---
<section>
  <div class="portfolio">
    {items.map((c) => (
      <a class="case reveal" href="/kontakt">
        <div class="img"><img src={c.image} loading="lazy" alt={`${c.name} – ${c.subtitle}`} /></div>
        <div class="meta">
          <div class="date">{c.date}</div>
          <h3>{c.name}</h3>
          <div class="sub">{c.subtitle}</div>
        </div>
      </a>
    ))}
  </div>
</section>
