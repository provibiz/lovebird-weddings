<section>
  <div class="portfolio">
    {cases.map((c) => (
      <a class="case reveal" href="/kontakt">
        <div class="img"><img src={`/assets/images/${c.img}`} loading="lazy" alt={`${c.name} – ${c.sub}`} /></div>
