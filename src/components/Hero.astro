---
import type { PageContent } from '@/lib/types';
import { sanitizeHtml } from '@/lib/sanitize';
interface Props { page: PageContent }
const { page } = Astro.props;

// hero_title: newlines → <br>, and *word* → italic gold (matches the template;
// the .hero h1 em CSS rule applies the gold colouring).
function renderTitle(raw: string): string {
  const escape = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return raw
    .split('\n')
    .map((line) => escape(line).replace(/\*([^*]+)\*/g, '<em>$1</em>'))
    .join('<br>');
}
const titleHtml = renderTitle(page.hero_title);
const heroImage = page.hero_image ?? '/assets/images/hero.jpg';
const heroTextHtml = sanitizeHtml(page.hero_text);
---
<section class="hero">
  <div class="hero-bg">
    <img
      src={heroImage}
      width="1600"
      height="900"
      fetchpriority="high"
      alt="Edle Hochzeitstafel im goldenen Licht – florale Arrangements, Kerzen und Kristallgläser"
    />
  </div>
  <div class="container hero-inner">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow">Lovebird Weddings &amp; Events</span>
        <h1 set:html={titleHtml}></h1>
        <div class="lead rt" set:html={heroTextHtml}></div>
        <div class="hero-meta">
          <a href={page.cta_link ?? '/kontakt'} class="cta cta-solid">{page.cta_text ?? 'Anfrage stellen'}</a>
          <a href="/portfolio" class="cta">Portfolio ansehen</a>
        </div>
      </div>
      <div class="hero-card reveal">
        <small>Persönlich · seit 2022</small>
        <h3>„Gemeinsam schaffen wir Erinnerungen."</h3>
        <p>
          Von der ersten Idee bis zum letzten Tanz – wir begleiten euch als Vertraute und
          Vorausdenkerin durch jede Phase eurer Hochzeitsplanung.
        </p>
        <div class="line"></div>
        <small>Standort</small>
        <p style="font-family:var(--serif);font-size:1.2rem;color:var(--ink)">
          zwischen Halle (Saale) und Leipzig
        </p>
      </div>
    </div>
  </div>
</section>
