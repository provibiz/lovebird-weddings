---
import '@/styles/dashboard.css';
interface Props { title: string; active?: string; cosmicConfigured?: boolean }
const { title, active = '', cosmicConfigured = true } = Astro.props;

const nav = [
  { href: '/dashboard', label: 'Dashboard', key: 'home' },
  { href: '/dashboard/startseite', label: 'Startseite', key: 'startseite' },
  { href: '/dashboard/leistungen', label: 'Leistungen', key: 'leistungen' },
  { href: '/dashboard/portfolio', label: 'Portfolio', key: 'portfolio' },
  { href: '/dashboard/faq', label: 'FAQ', key: 'faq' },
  { href: '/dashboard/medien', label: 'Medien', key: 'medien' },
  { href: '/dashboard/kontakt', label: 'Kontaktdaten', key: 'kontakt' },
  { href: '/dashboard/seo', label: 'SEO', key: 'seo' },
];
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Lovebird Dashboard</title>
    <!-- Fonts are self-hosted via styles/dashboard.css → fonts.css -->
  </head>
  <body>
    <div class="d-shell">
      <aside class="d-side">
        <div class="brand">Lovebird<small>Dashboard</small></div>
        <div class="hint">Pflege deine Website-Inhalte</div>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
        <div class="spacer"></div>
        <a href="/" target="_blank" class="hint" style="text-decoration:underline">Website ansehen ↗</a>
        <form method="POST" action="/api/logout" style="margin-top:14px">
          <button type="submit">Abmelden</button>
        </form>
      </aside>
      <main class="d-main">
        {!cosmicConfigured && (
          <div class="banner">
            <strong>Vorschau-Modus:</strong> Cosmic ist noch nicht verbunden. Eingaben werden
            geprüft, aber noch nicht gespeichert. Sobald die Zugangsdaten hinterlegt sind,
            funktioniert das Speichern automatisch.
          </div>
        )}
        <slot />
      </main>
    </div>

    <!-- Shared image picker modal -->
    <div class="media-modal" data-media-modal hidden>
      <div class="media-modal-card">
        <header>
          <strong>Bild wählen</strong>
          <label class="btn-add" style="cursor:pointer">
            + Hochladen
            <input type="file" accept="image/*" data-media-upload hidden />
          </label>
          <button type="button" class="media-close" data-media-close aria-label="Schließen">✕</button>
        </header>
        <p class="media-status" data-media-status></p>
        <div class="media-grid" data-media-grid></div>
      </div>
    </div>

    <script>
      // Shared save handler for any [data-save-form].
      // Builds a nested payload from input names like `services[0][title]`.
      function buildData(form: HTMLFormElement) {
        const data: any = {};
        const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          '[name]'
        );
        fields.forEach((el) => {
          const name = el.name;
          const m = name.match(/^([a-zA-Z_]+)\[(\d+)\]\[([a-zA-Z_]+)\]$/);
          if (m) {
            const [, arr, idx, key] = m;
            data[arr] ??= [];
            data[arr][+idx] ??= {};
            data[arr][+idx][key] = el.value;
          } else {
            data[name] = el.value;
          }
        });
        // compact sparse arrays
        for (const k of Object.keys(data)) {
          if (Array.isArray(data[k])) data[k] = data[k].filter(Boolean);
        }
        return data;
      }

      function clearErrors(form: HTMLFormElement) {
        form.querySelectorAll('.field.has-error').forEach((f) => f.classList.remove('has-error'));
      }

      function showFieldErrors(form: HTMLFormElement, errs: Record<string, string>) {
        for (const [path, msg] of Object.entries(errs)) {
          const el = form.querySelector(`[data-field="${path}"]`) || form.querySelector(`[name="${path}"]`)?.closest('.field');
          if (el) {
            el.classList.add('has-error');
            const e = el.querySelector('.err');
            if (e) e.textContent = msg;
          }
        }
      }

      document.querySelectorAll<HTMLFormElement>('[data-save-form]').forEach((form) => {
        const section = form.dataset.section!;
        const status = form.querySelector<HTMLElement>('[data-status]');
        const btn = form.querySelector<HTMLButtonElement>('.btn-save');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          // sync rich-text editors into their hidden textareas first
          form.querySelectorAll<HTMLElement>('[data-rte]').forEach((rte) => {
            const a = rte.querySelector<HTMLElement>('[data-rte-area]');
            const i = rte.querySelector<HTMLTextAreaElement>('[data-rte-input]');
            if (a && i) i.value = a.innerHTML;
          });
          clearErrors(form);
          if (status) { status.textContent = ''; status.className = 'status'; }
          btn?.setAttribute('disabled', 'true');
          try {
            const res = await fetch('/api/save', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ section, data: buildData(form) }),
            });
            const json = await res.json();
            if (json.ok) {
              if (status) { status.textContent = json.message ?? 'Gespeichert.'; status.className = 'status ok'; }
            } else {
              if (json.fieldErrors) showFieldErrors(form, json.fieldErrors);
              if (status) { status.textContent = json.error ?? 'Fehler beim Speichern.'; status.className = 'status error'; }
            }
          } catch {
            if (status) { status.textContent = 'Netzwerkfehler. Bitte erneut versuchen.'; status.className = 'status error'; }
          } finally {
            btn?.removeAttribute('disabled');
          }
        });
      });

      // live character counters
      document.querySelectorAll<HTMLElement>('[data-counter]').forEach((counter) => {
        const max = +(counter.dataset.counter || '0');
        const input = document.getElementById(counter.dataset.for!) as HTMLInputElement | HTMLTextAreaElement | null;
        if (!input) return;
        const update = () => {
          const len = input.value.length;
          counter.textContent = `${len} / ${max}`;
          counter.classList.toggle('over', len > max);
        };
        input.addEventListener('input', update);
        update();
      });

      // ── Rich-text editors ───────────────────────────────────
      function initRte(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>('[data-rte]').forEach((rte) => {
          if (rte.dataset.ready) return;
          rte.dataset.ready = '1';
          const area = rte.querySelector<HTMLElement>('[data-rte-area]')!;
          const input = rte.querySelector<HTMLTextAreaElement>('[data-rte-input]')!;
          const sync = () => (input.value = area.innerHTML);
          area.addEventListener('input', sync);
          area.addEventListener('blur', sync);
          rte.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((btn) => {
            btn.addEventListener('mousedown', (e) => e.preventDefault());
            btn.addEventListener('click', () => {
              const cmd = btn.dataset.cmd!;
              area.focus();
              if (cmd === 'createLink') {
                const url = prompt('Link-Adresse (https://… oder /seite):', 'https://');
                if (url) document.execCommand('createLink', false, url);
              } else {
                document.execCommand(cmd, false);
              }
              sync();
            });
          });
        });
      }
      (window as any).__initRte = initRte;
      initRte();

      // ── Image pickers + shared media modal ──────────────────
      const modal = document.querySelector<HTMLElement>('[data-media-modal]');
      const grid = modal?.querySelector<HTMLElement>('[data-media-grid]');
      const mStatus = modal?.querySelector<HTMLElement>('[data-media-status]');
      const uploadInput = modal?.querySelector<HTMLInputElement>('[data-media-upload]');
      let activePicker: HTMLElement | null = null;
      let mediaCache: any[] | null = null;

      async function loadMedia(force = false) {
        if (mediaCache && !force) return mediaCache;
        if (mStatus) mStatus.textContent = 'Lädt…';
        const res = await fetch('/api/media');
        const j = await res.json();
        if (mStatus) mStatus.textContent = '';
        mediaCache = j.ok ? j.items : [];
        return mediaCache!;
      }
      function renderGrid(items: any[]) {
        if (!grid) return;
        grid.innerHTML = '';
        items.forEach((it) => {
          const fig = document.createElement('button');
          fig.type = 'button';
          fig.className = 'media-thumb';
          fig.innerHTML = `<img src="${it.url}" alt="" decoding="async">`;
          fig.addEventListener('click', () => choose(it.url));
          grid!.appendChild(fig);
        });
      }
      function choose(url: string) {
        if (!activePicker) return;
        activePicker.querySelector<HTMLInputElement>('[data-imgpick-input]')!.value = url;
        const prev = activePicker.querySelector<HTMLElement>('[data-imgpick-preview]')!;
        prev.innerHTML = `<img src="${url}" alt="">`;
        activePicker.querySelector<HTMLElement>('[data-imgpick-clear]')?.removeAttribute('hidden');
        closeModal();
      }
      function openModal(picker: HTMLElement) {
        activePicker = picker;
        modal?.removeAttribute('hidden');
        loadMedia().then(renderGrid);
      }
      function closeModal() {
        modal?.setAttribute('hidden', '');
        activePicker = null;
      }
      modal?.querySelector('[data-media-close]')?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      uploadInput?.addEventListener('change', async () => {
        const file = uploadInput.files?.[0];
        if (!file) return;
        if (mStatus) mStatus.textContent = 'Lädt hoch…';
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch('/api/media', { method: 'POST', body: fd });
        const j = await res.json();
        uploadInput.value = '';
        if (j.ok) { mediaCache = null; const items = await loadMedia(true); renderGrid(items); if (activePicker) choose(j.item.url); }
        else if (mStatus) mStatus.textContent = j.error ?? 'Upload fehlgeschlagen.';
      });
      function initImgPick(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>('[data-imgpick]').forEach((p) => {
          if (p.dataset.ready) return;
          p.dataset.ready = '1';
          p.querySelector('[data-imgpick-open]')?.addEventListener('click', () => openModal(p));
          p.querySelector('[data-imgpick-clear]')?.addEventListener('click', () => {
            p.querySelector<HTMLInputElement>('[data-imgpick-input]')!.value = '';
            p.querySelector('[data-imgpick-preview]')!.innerHTML = '<span class="imgpick-empty">Kein Bild</span>';
            p.querySelector('[data-imgpick-clear]')?.setAttribute('hidden', '');
          });
        });
      }
      (window as any).__initImgPick = initImgPick;
      initImgPick();
    </script>
  </body>
</html>
